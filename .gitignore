# Dependencies & build output
node_modules/
dist/

# Secrets (Deepgram key etc.)
.env
.env.*

# Test artifacts
test-results/
playwright-report/
blob-report/

# Video projects: each has its own git history + media. A fresh clone gets a blank
# project/ generated from templates/project/ on first `npm run dev`.
/project/
/projects/

# Loose media anywhere in the repo
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg

# OS / editor junk
.DS_Store
*.log
.vscode/
.idea/

# Local state shared across projects (e.g. the Gemini TTS daily request ledger)
/.cache/
