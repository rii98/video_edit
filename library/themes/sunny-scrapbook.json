    "bg": "#FFF3DC",
    "surface": "#FFD84D",
    "text": "#2A1E17",
    "muted": "#8C7A6B",
    "accent": "#FF5A5F",
    "accent2": "#1FA9E0"
  },
  "fonts": {
    "display": "Fredoka",
    "body": "Nunito",
    "mono": "Caveat"
  },
  "type": {
    "displayWeight": 700,
    "displayTracking": "-0.01em",
    "uppercaseDisplay": false
  },
  "easing": {
    "standard": [0.34, 1.56, 0.64, 1],
    "emphasized": [0.68, -0.4, 0.27, 1.4]
