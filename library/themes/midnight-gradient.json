{
  "name": "Midnight Gradient",
  "description": "Dark SaaS: deep charcoal, fine borders, indigo/cyan aurora glow, crisp sans. Developer tools and B2B launches.",
  "colors": {
    "bg": "#08090A",
    "surface": "#141518",
    "text": "#F7F8F8",
    "muted": "#8A8F98",
    "accent": "#5E6AD2",
    "accent2": "#26B5CE"
  },
  "fonts": {
