{
  "name": "Warm Editorial",
  "description": "Cream paper, serif headlines, warm accents. Thoughtful, human, editorial (think brand essays and research launches).",
  "colors": {
    "bg": "#F4EFE6",
    "surface": "#FFFFFF",
    "text": "#1F1B16",
    "muted": "#6B6258",
    "accent": "#D9653B",
    "accent2": "#2F5D50"
  },
  "fonts": {
    "display": "Instrument Serif",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "type": {
    "displayWeight": 400,
    "displayTracking": "-0.01em",
    "uppercaseDisplay": false
  },
  "easing": {
    "standard": [
      0.22,
      1,
      0.36,
      1
    ],
    "emphasized": [
      0.65,
      0,
      0.35,
      1
    ]
  },
  "tempo": 1,
  "stagger": 3,
  "radius": 28
}
